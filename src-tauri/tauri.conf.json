{
  "$schema": "https://schema.tauri.app/config/2",
  "productName": "Toolbox",
  "version": "0.1.0",
  "identifier": "com.emmersonmena.toolbox",
  "build": {
    "beforeDevCommand": "npm run dev",
    "devUrl": "http://localhost:1420",
    "beforeBuildCommand": "npm run build",
    "frontendDist": "../dist"
  },
  "app": {
    "windows": [
      {
        "title": "Toolbox",
        "width": 1200,
        "height": 800,
        "minWidth": 880,
        "minHeight": 640,
        "resizable": true,
        "center": true
      }
    ],
    "security": {
      "assetProtocol": {
        "enable": true,
        "scope": ["**"]
      },
      "csp": null
    }
  },
  "bundle": {
    "active": true,
    "targets": ["nsis"],
    "icon": [
      "icons/32x32.png",
      "icons/128x128.png",
      "icons/128x128@2x.png",
      "icons/icon.icns",
      "icons/icon.ico"
    ],
    "shortDescription": "Local-first image tools for developers",
    "longDescription": "Convert, compress, and prepare website image assets locally — nothing is ever uploaded.",
    "publisher": "Emmerson Mena",
    "category": "Utility",
    "copyright": "© 2026 Emmerson Mena",
    "windows": {
      "nsis": {
        "installMode": "currentUser",
        "languages": ["English"],
        "displayLanguageSelector": false
      }
    }
  }
}
